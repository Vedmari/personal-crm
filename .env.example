# Copy this file to .env and fill in the values.
# .env holds real secrets and must never be committed.

# Local Postgres (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string used by the app and Drizzle:
# postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Sign-in (Better Auth).
# A random string of at least 32 characters that signs the sign-in cookies:
# `openssl rand -base64 32`. A new value signs everybody out.
BETTER_AUTH_SECRET=
# The address the app is opened at; links in sign-in emails lead here.
# This computer: http://localhost:3000. Server: https://app.lichnaya-crm.ru
BETTER_AUTH_URL=

# Where sign-in emails go.
# This computer: smtp://localhost:1025 (Mailpit from docker-compose.yml).
# Server: smtps://resend:<Resend API key>@smtp.resend.com:465
SMTP_URL=

# The email of the owner: contacts, notes and groups that are already in the
# database, and the test data of `pnpm db:seed`, belong to this user.
# Read by `pnpm db:migrate` and `pnpm db:seed`.
OWNER_EMAIL=

# The Mailpit web page and API, read by the e2e tests to open the sign-in
# link. Optional: http://localhost:8025 when empty.
MAILPIT_URL=
